Sub_onReceiveTalkNPC(Name, Count, Chat[])
     IF CheckMapGPSdataUse() = ("ElarandorSilvarisPortalToNpcNaeris GPS.txt")
          IF CheckReceiveTalkNPC(Name) = ("Naeris")
               IF CheckReceiveTalkNPC(Count) == 3
                    IF CheckReceiveTalkNPC(Chat[0]) C= ("The runes weaken with each passing day.")
                         ConsolePrint("The runes weaken with each passing day.")
                         IF CheckReceiveTalkNPC(Chat[1]) C= ("Until Elarion is healed, they must be renewed again and again.")
                              ConsolePrint("Until Elarion is healed, they must be renewed again and again.")
                              IF CheckReceiveTalkNPC(Chat[2]) C= ("Will you restore them?")
                                   ConsolePrint("Will you restore them?")
                                   ScriptGO.TalkNPCRetrun("I will!")
                                   ConsolePrint("I will!")
               ElseIF CheckReceiveTalkNPC(Count) == 2
                    IF CheckReceiveTalkNPC(Chat[0]) C= ("Gather Magical Essences from Mana Wisps.")
                         ConsolePrint("Gather Magical Essences from Mana Wisps.")
                         IF CheckReceiveTalkNPC(Chat[1]) C= ("Restore the power of three Rune Stones.")
                              ConsolePrint("Restore the power of three Rune Stones.")
                              ScriptGO.TalkNPCRetrun("Farewell!")
                              ConsolePrint("Farewell!")
                              ScriptGO.ChangeMapRuteData()
                              ConsolePrint("Go to Npc Elyndor")
     ElseIF CheckMapGPSdataUse() = ("ElarandorNpcNaerisToElyndor GPS.txt")
          IF CheckReceiveTalkNPC(Name) = ("Elyndor")
               IF CheckReceiveTalkNPC(Count) == 2
                    IF CheckReceiveTalkNPC(Chat[0]) C= ("The corruption never rests. More beasts fall to its influence each day.")
                         ConsolePrint("The corruption never rests. More beasts fall to its influence each day.")
                         IF CheckReceiveTalkNPC(Chat[1]) C= ("Will you help me thin their numbers?")
                              ConsolePrint("Will you help me thin their numbers?")
                              ScriptGO.TalkNPCRetrun("I'll help!")
                              ConsolePrint("I'll help!")
                    ElseIF CheckReceiveTalkNPC(Chat[0]) C= ("Hunt 30 Dire Animals throughout Silvaris.")
                         ConsolePrint("Hunt 30 Dire Animals throughout Silvaris.")
                         IF CheckReceiveTalkNPC(Chat[1])  C= ("Return once the forest has grown quieter.")
                              ConsolePrint("Return once the forest has grown quieter.")
                              ScriptGO.TalkNPCRetrun("Farewell!")
                              ConsolePrint("Farewell!")
                              ScriptGO.SetSQL("Quest") = "Do_Quest"
                              ScriptGO.ChangeMapRuteData("ElanradorWolfHunt GPS.dat")
                              GoToSUB.SUB_Follow()
                              ConsolePrint("Start hunt wolf")
     ElseIF CheckReceiveTalkNPC(Name) = ("Elyndor")
          IF CheckReceiveTalkNPC(Count) == 3
               IF CheckReceiveTalkNPC(Chat[0]) C= ("Another part of Silvaris has been reclaimed.")
                    ConsolePrint("Another part of Silvaris has been reclaimed.")
                    IF CheckReceiveTalkNPC(Chat[1]) C= ("Though I fear the corruption will not stay away for long.")
                         ConsolePrint("Though I fear the corruption will not stay away for long.")
                         IF CheckReceiveTalkNPC(Chat[2]) C= ("You have my thanks.")
                              ConsolePrint("You have my thanks.")
                              ScriptGO.TalkNPCRetrun("Farewell!")
                              ConsolePrint("Farewell!")
